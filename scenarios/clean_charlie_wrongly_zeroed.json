{
  "name": "Staking Vault: Clean Upgrade (Charlie Wrongly Expected Zero)",
  "description": "Tests the strict matcher when Charlie's reward is wrongly configured with expectedPostValue=0 (or maxValue=0). Proves that unauthorized or mismatched expectations fail strictly.",
  "v1Artifact": "out/StakingVaultV1.sol/StakingVaultV1.json",
  "v2Artifact": "out/StakingVaultV2_Clean.sol/StakingVaultV2_Clean.json",
  "proxyArtifact": "out/ERC1967Proxy.sol/ERC1967Proxy.json",
  "setup": {
    "rewardRate": "1000000000000",
    "advanceTimeSeconds": 604800,
    "actors": [
      {
        "name": "alice",
        "depositEth": "100"
      },
      {
        "name": "bob",
        "depositEth": "250"
      },
      {
        "name": "charlie",
        "depositEth": "50"
      }
    ]
  },
  "expectedChanges": [
    {
      "functionName": "version",
      "actorLabel": "GLOBAL",
      "expectedPostValue": "V2_Clean",
      "allowed": true,
      "reason": "Implementation version updated to V2_Clean"
    },
    {
      "functionName": "getClaimableReward",
      "actorLabel": "alice",
      "minValue": "66000000000000000000",
      "maxValue": "67000000000000000000",
      "allowed": true,
      "reason": "Alice 10% loyalty duration bonus applied backward-compatibly (~66.53 ETH)"
    },
    {
      "functionName": "getClaimableReward",
      "actorLabel": "bob",
      "minValue": "166000000000000000000",
      "maxValue": "167000000000000000000",
      "allowed": true,
      "reason": "Bob 10% loyalty duration bonus applied backward-compatibly (~166.32 ETH)"
    },
    {
      "functionName": "getClaimableReward",
      "actorLabel": "charlie",
      "expectedPostValue": "0",
      "allowed": true,
      "reason": "Charlie reward wrongly expected to drop to 0"
    }
  ]
}
